{
  "name": "orca-sdk",
  "version": "0.1.0",
  "description": "Orca SDK",
  "main": "./dist/index.js",
  "types": "./index.ts",
  "module": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.ts"
  ],
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node",
    "build:watch": "bun build ./index.ts --outdir ./dist --target node --watch",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
